JWT_SECRET=test1234
REFRESH_TOKEN_SECRET=test1234

# Set to "production" on a deployed https instance: auth cookies become
# secure + strict (which breaks login over plain http — keep "development"
# for local dev), and unconfigured email is dropped instead of being caught
# by MailHog. scripts/generate-env.sh sets this based on the instance URL.
NODE_ENV=development

PORT=3000
API_DOMAIN='http://localhost:3000'
STATIC_MEDIA_HOST=http://localhost:3000

# NGINX_PORT=3001
MEDIA_LOCATION=./data/media/
TEMP_LOCATION=/tmp/data/media/

DATABASE_URL="postgresql://nomads:nomads@pgsql:5432/nomads?schema=public"
POSTGRES_LOCAL_MACHINE_PORT=5434
POSTGRES_PASSWORD=nomads
POSTGRES_USER=nomads

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password

# Object storage for development is Garage (scripts/garage/garage.toml); the
# MINIO_* names are kept because that's what src/utils/minio.ts reads.
# Garage validates the shape of its S3 keys: the access key must be "GK"
# followed by 24 hex characters, and the secret exactly 64 hex characters.
# A wrong shape fails at import with "Invalid key format"; a mismatched pair
# fails every request with "AuthorizationHeaderMalformed".
MINIO_HOST=minio
MINIO_ROOT_USER=GK0e7a1c94b2df63805a7e4d12
MINIO_ROOT_PASSWORD=5f3b9d20c8a7e146b0d94f27a3c5e8b16d20f74a9c3e581bd67a0f4923ce8d15
MINIO_API_PORT=9000
# Optional: a browser-reachable host for MinIO, used to presign download URLs
# in development (docker-compose maps the MinIO API port to the host). When
# unset, downloads are streamed through the API instead of presigned.
# MINIO_PUBLIC_HOST=localhost
# MINIO_PUBLIC_PORT=9000

MAILHOG_PORT=1025

# These are over written by the admin settings. You can leave them blank unless you 
# would prefer to set them during devops.
STRIPE_KEY=
STRIPE_WEBHOOK_CONNECT_SIGNING_SECRET=

# Which object storage to use: "minio" or "s3" (Backblaze, Hetzner, etc.).
# Usually unnecessary: when unset, Mirlo uses an S3 service if the S3
# credentials below are filled in, and MinIO otherwise.
# STORAGE_BACKEND=minio

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
